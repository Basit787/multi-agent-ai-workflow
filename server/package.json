{
  "name": "server",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "build": "nest build",
    "deploy": "nest deploy",
    "start": "nest start",
    "start:dev": "nest start --watch --exec \"node --env-file-if-exists=../.env\"",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/src/main.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx --env-file-if-exists=../.env libs/db/src/seed.ts",
    "db:reset": "tsx --env-file-if-exists=../.env libs/db/src/reset.ts && drizzle-kit migrate",
    "format": "biome format --write",
    "lint": "biome lint",
    "check": "biome check"
  },
  "dependencies": {
    "@nestjs/bullmq": "12.0.0",
    "@nestjs/common": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/platform-express": "^12.0.1",
    "bcryptjs": "^2.4.3",
    "better-auth": "1.7.14",
    "bullmq": "6.5.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "drizzle-orm": "^0.38.4",
    "helmet": "^8.3.0",
    "ioredis": "6.0.0",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.5",
    "@nestjs/cli": "^12.0.0",
    "@nestjs/mau": "^0.2.6",
    "@nestjs/schematics": "^12.0.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.30.6",
    "source-map-support": "^0.5.21",
    "tsx": "^4.23.15",
    "typescript": "^6.0.2"
  },
  "packageManager": "pnpm@12.14.0"
}
